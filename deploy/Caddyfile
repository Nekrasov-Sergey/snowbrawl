# Caddy: автоматический TLS (Let's Encrypt) и проксирование WebSocket на сервер игры.

# Глобальные настройки обязаны идти первым блоком файла.
{
	# Почта аккаунта ACME: Let's Encrypt предупредит письмом, если продление сертификата сломается.
	email 79508031750@yandex.ru
}

{$SNOWBRAWL_DOMAIN} {
	encode zstd gzip
	# X-Forwarded-For Caddy проставляет сам, вручную дублировать не нужно.
	reverse_proxy server:8080
}

# www — на канонический адрес. Сертификат Caddy получит сам, A-запись на www нужна.
www.{$SNOWBRAWL_DOMAIN} {
	redir https://{$SNOWBRAWL_DOMAIN}{uri} permanent
}

# Заход по IP или чужому имени. ACME-проверку Caddy обслуживает своим маршрутом
# раньше этого блока, поэтому выпуск сертификата он не ломает.
http:// {
	redir https://{$SNOWBRAWL_DOMAIN}{uri} permanent
}
