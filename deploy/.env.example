# Скопируйте в .env рядом с docker-compose.yml и заполните.

# Образ сервера. Тег = версия релиза (git-тег), latest — последний релиз.
SNOWBRAWL_IMAGE=ghcr.io/nekrasov-sergey/snowbrawl:latest

# Токен админки: /admin/?token=... Придумайте длинную случайную строку:
#   openssl rand -hex 24
SNOWBRAWL_ADMIN_TOKEN=change-me

# Домен для профиля tls (после покупки домена и A-записи на IP сервера).
SNOWBRAWL_DOMAIN=snowbrawl.example.ru

# true — поднимать Caddy с сертификатом Let's Encrypt (профиль tls) и не публиковать
# порт сервера наружу. false — игра отдаётся по IP на SNOWBRAWL_HTTP_PORT.
SNOWBRAWL_TLS=false

# База SQLite в томе snowbrawl_data: игроки (гости и аккаунты), график онлайна, ключ подписи кук.
# Суточные снимки сервер кладёт рядом, в /data/backup. Пусто — временная база, пропадает при перезапуске.
SNOWBRAWL_DB=/data/snowbrawl.db
# Старые файлы до базы: переносятся в неё один раз, при первом старте, и переименовываются в *.imported.
SNOWBRAWL_MODERATION_FILE=/data/moderation.json
SNOWBRAWL_ONLINE_FILE=/data/online.log
SNOWBRAWL_ACCOUNTS_FILE=/data/accounts.json

# Вход по Яндекс ID. Приложение заводится на https://oauth.yandex.ru/client/new:
# тип «Веб-сервисы», право login:info, Redirect URI — https://<домен>/auth/yandex/callback.
# Пустой CLIENT_ID или SECRET — вход выключен, игроки заходят гостями.
SNOWBRAWL_YANDEX_CLIENT_ID=
SNOWBRAWL_YANDEX_CLIENT_SECRET=
# Адрес, по которому игроки открывают игру: из него строится redirect_uri и решается,
# ставить ли куке входа флаг Secure. Обязателен, если вход включён.
SNOWBRAWL_PUBLIC_URL=https://snowbrawl.example.ru
# Ключ подписи кук гостя и входа (openssl rand -hex 32). Пусто — сервер создаст его сам и
# сохранит в базе. Менять или терять его значит разом сделать всех гостей новыми и разлогинить аккаунты.
SNOWBRAWL_AUTH_SECRET=

# Необязательные настройки.
SNOWBRAWL_MAX_CONNS=200
SNOWBRAWL_LOG_LEVEL=info
# Порт HTTP без Caddy (демо по IP).
SNOWBRAWL_HTTP_PORT=80
